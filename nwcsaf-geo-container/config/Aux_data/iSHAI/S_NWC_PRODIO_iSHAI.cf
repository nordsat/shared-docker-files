# Attributes for Container ishai_bl
# ------------------------------------
BLOCK_ishai_bl
standard_name        
long_name            iSHAI Precipitable Water in Boundary Layer
scale_factor         0.01
add_offset           0.0
units                mm 
valid_range          0, 3500
_FillValue           65535 
ancillary_variables  ishai_status_flag ishai_conditions ishai_quality ishai_bl_pal
coordinates          time ny nx
grid_mapping         projection_definition
comment      
BLOCK_END

# Attributes for Container ishai_ml
# ------------------------------------
BLOCK_ishai_ml
standard_name        
long_name            iSHAI Precipitable Water in Medium Layer
scale_factor         0.01
add_offset           0.0
units                mm
valid_range          0, 4500
_FillValue           65535
ancillary_variables  ishai_status_flag ishai_conditions ishai_quality ishai_ml_pal
coordinates          time ny nx
grid_mapping         projection_definition
comment	
BLOCK_END

