# ------------------------------------
BLOCK_IR_band
standard_name        toa_brightness_temperature
long_name            IR_band BT for display on cloudy pixels
units                
valid_range          0, 127
_FillValue           255
ancillary_variables  IR_band_pal
coordinates          time ny nx
grid_mapping         projection_definition
BLOCK_END

