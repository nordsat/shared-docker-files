# Attributes for Container ishai_status_flag
# ------------------------------------
BLOCK_ishai_status_flag
standard_name        status_flag
long_name            iSHAI status flags
valid_range          0, 255
_FillValue           32768
flag_mask            1,      2,     4,    8,   16,   32
flag_values          1,      2,     4,    8,   16,   32
flag_meanings        Cloud_free
flag_meanings        Pixel_has_been_processed_without_error
flag_meanings        First_guess_regression_step_has_been_applied
flag_meanings        1st_iteration_of_physical_retrieval_has_been_done
flag_meanings        2nd_iteration_of_physical_retrieval_has_been_done
flag_meanings        3rd_iteration_of_physical_retrieval_has_been_done
coordinates          time ny nx
grid_mapping         projection_definition
comment	
BLOCK_END

