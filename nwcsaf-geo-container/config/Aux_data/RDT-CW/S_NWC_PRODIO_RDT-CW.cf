# RDT_CW
# -------------------------------------------
TILE      NWC GEO Convection Warning Product
SUMMARY   Convection Warning Product of the NWC/GEO. Information about significant convective systems from the triggering to mature phase
KEYWORDS  Convection, Convective Clouds/Systems (observed/analyzed)
CDM       Bulletin

# Palette Definition
# ------------------------------
PALETTE
PAL_ID          MapCellCatType_pal
PAL_FILE        S_NWC_PALETTE_rdtcw.pal
PALETTE_END

# Attributes for Container MapCellCatType_pal
# ------------------------------------
BLOCK_MapCellCatType_pal
long_name            RGB palette for MapCellCatType
valid_range          0, 255
colormodel           RGB
comment              Palette applicable to field MapCellCatType
BLOCK_END


# Attributes for QContainer NbSigCell
# -------------------------------------------
BLOCK_NbSigCell
standard_name        
long_name            Number of encoded significant RDT-CW cloud cells
scale_factor         1.0
add_offset           0.0
units                1
valid_range          0, 5000
_FillValue           65535
ancillary_variables  
coordinates          
comment              
BLOCK_END

