# PCPh
# -------------------------------------------
TITLE       NWC GEO Precipitating Clouds from Cloud Physical Properties
SUMMARY     Precipitating Clouds Product of the NWC/GEO. Probability of precipitation in pre-defined probability intervals from Cloud Physical Properties
KEYWORDS    Precipitation Probability
CDM         Image

# Palette Definition
# ------------------------------
PALETTE
PAL_ID          pcph_pal
PAL_FILE        S_NWC_PALETTE_pcph.pal
PALETTE_END

# Attributes for Container pcph
# -------------------------------------------
BLOCK_pcph
standard_name        
long_name            NWC GEO PCPh Precipitating Clouds
scale_factor         1.0
add_offset           0.0
units                100
valid_range          0, 101
_FillValue           65535
ancillary_variables  pcph_status_flag  pcph_conditions pcph_quality pcph_pal
coordinates          time ny nx
grid_mapping         projection_definition
comment              
BLOCK_END

# Attributes for Container pcph_status_flag
# ------------------------------------
BLOCK_pcph_status_flag
standard_name        status_flag
long_name            Information on specific NWC GEO PCPh processing
valid_range          1, 256
_FillValue           32768
coordinates          time ny nx
grid_mapping         projection_definition
comment              
flag_mask            1, 2, 4, 8, 16, 256
flag_values          1, 2, 4, 8, 16, 256
flag_meanings        microphysics_data_missing
flag_meanings        phase_not_available
flag_meanings        ir_band_missing
flag_meanings        parallax_correction_applied
flag_meanings        stability_correction_applied
flag_meanings        data_hole_filled
BLOCK_END

# Attributes for Container pcph_pal
# ------------------------------------
BLOCK_pcph_pal
long_name            RGB palette for pcph
valid_range          0, 255
colormodel           RGB
comment              Palette applicable to field pcph
BLOCK_END
