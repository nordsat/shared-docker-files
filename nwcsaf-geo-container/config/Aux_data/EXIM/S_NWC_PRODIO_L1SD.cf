#/* HISTORY
# *
# *  DATE      VERSION     AUTHOR     REASONS
# * JUN 2016    v1.0        GMV      First Version of GEO-L1SD PGE/Tool
# * JAN 2020    vMTG        GMV      Update of output product format for vMTG
# * APR 2021    2.0         GMV       Update for vMTG. Update of L1SD format 
# * OCT 2023    v2024       GMV      SPR-780. Paralax correction for MTG
# **************************************************************************/
#


# L1SD
# -------------------------------------------
TITLE       NWC/GEO Level 1 Satellite Product
SUMMARY     Level 1 Satellite data. Refer to NWC/CDOP2/MTG/AEMET/SW/ACDD Section A.1 for details on satellite band data
KEYWORDS    Satellite Data
CDM         Image


# Palette Definition
# ------------------------------
PALETTE
PAL_ID          l1sd_refl_pal
PAL_FILE        S_NWC_PALETTE_l1sd_refl.pal
PALETTE_END

PALETTE
PAL_ID          l1sd_bt_ir_pal
PAL_FILE        S_NWC_PALETTE_l1sd_bt_ir.pal
PALETTE_END

PALETTE
PAL_ID          l1sd_bt_wv_pal
PAL_FILE        S_NWC_PALETTE_l1sd_bt_wv.pal
PALETTE_END



# ==========================================================================


# Attributes for Container l1sd_VIS04_rad
# ------------------------------------
BLOCK_l1sd_VIS04_rad
standard_name        Radiance_VIS04
long_name            Radiance_VIS04
scale_factor         0.01
add_offset           0.0
units                mW m-2 sr-1 (cm-1)-1
valid_range          0 60000
_FillValue           65535
ancillary_variables  l1sd_conditions l1sd_quality
coordinates          time ny nx
grid_mapping         projection_definition
comment              
BLOCK_END

