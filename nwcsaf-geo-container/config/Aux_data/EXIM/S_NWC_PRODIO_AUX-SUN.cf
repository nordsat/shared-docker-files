# Attributes for Header - AUX-SUN
# ------------------------------
TITLE       NWC GEO Auxiliary Product - Sun angles
SUMMARY     Solar azimuth and zenith angles data Product of the NWC/GEO
KEYWORDS    Auxiliary
CDM         Image

# Palette Definition
# ------------------------------


# Attributes for Container sun_azimuth
# ------------------------------------
BLOCK_sun_azimuth
standard_name        solar_azimuth_angle
long_name            Sun azimuth angle at the centre of each pixel
units                degrees
valid_range          0.0 360.0
_FillValue           -9999.0
BLOCK_END

# Attributes for Container sun_zenith
# ------------------------------------
BLOCK_sun_zenith
standard_name        solar_zenith_angle
long_name            Sun zenith angle at the centre of each pixel
units                degrees
valid_range          0.0, 180.0
_FillValue           -9999.0
BLOCK_END
