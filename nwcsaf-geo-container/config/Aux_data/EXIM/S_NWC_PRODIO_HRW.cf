# HRW
# -------------------------------------------
TITLE     NWC/GEO-High Resolution Winds Product
SUMMARY   High Resolution Winds Product of the NWC/GEO. Detailed sets of Atmospheric Motion Vectors or Trajectories throughout all hours of the day, considering visible, infrared and water vapour channel data
KEYWORDS  Atmospheric Motion Vectors or Trajectories, Satellite winds or trajectories
CDM       Bulletin

# Attributes for observations 
# -------------------------------------------
BLOCK_observations
standard_name
long_name            AMV_number
units                1
valid_range          0u, 16777214u
_FillValue           16777215
ancillary_variables
coordinates          time lat lon
comment              AMV identifier
BLOCK_END

# Attributes for trajectory
# -------------------------------------------
BLOCK_trajectory
long_name            trajectory_number
units                1
valid_range          0u, 16777214u
_FillValue           16777215
ancillary_variables
coordinates          time lat lon
comment              Trajectory identifier
cf_role              trajectory_id
BLOCK_END

# Attributes for observationst
# -------------------------------------------
BLOCK_observationst
long_name            point_inside_the_trajectory
units                1
valid_range          0ub, 25ub
_FillValue           31
ancillary_variables
coordinates          time lat lon
comment              Point inside the trajectory; values between 1 (initial point) and 1+number of trajectory segments (last point) 
BLOCK_END

# Attributes for obs_time
# -------------------------------------------
BLOCK_obs_time
standard_name
long_name            trajectory_point_observation_time
units                seconds since 1970-01-01 00:00:00 
valid_range          1., 2147483646. 
_FillValue           0.
ancillary_variables
coordinates          time lat lon
comment              Trajectory point observation time 
BLOCK_END

# Attributes for wind_id
# -------------------------------------------
BLOCK_wind_id
standard_name
long_name            wind_id
units                1
valid_range          0u, 16777214u
_FillValue           16777215
ancillary_variables
coordinates          time lat lon
comment              AMV identifier; wind_id changes for each slot
BLOCK_END

# Attributes for wind_prev_id
# -------------------------------------------
BLOCK_wind_prev_id
standard_name        
long_name            wind_prev_id
units                1
valid_range          0u, 16777214u
_FillValue           16777215
ancillary_variables  
coordinates          time lat lon
comment              AMV identifier in the previous slot; wind_id in current slot and wind_prev_id in previous slot are used to identify two consecutive segments of the same trajectory
BLOCK_END

# Attributes for number_of_winds
# ------------------------------
BLOCK_number_of_winds
standard_name        
long_name            number_of_winds
units                1
valid_range          0ub, 3ub
_FillValue           7
ancillary_variables  
coordinates          time lat lon
comment              Number of AMVs calculated for the same tracer by HRW
BLOCK_END

# Attributes for correlation_test
# ------------------------------
BLOCK_correlation_test
standard_name        
long_name            correlation_test
units                1
valid_range          0ub, 3ub
_FillValue           7
ancillary_variables  
coordinates          time lat lon
comment              Correlation test; Values based on BUFR code table 060201
flag_values          0, 1, 2, 3
flag_meanings        AMV_which_is_not_the_initially_calculated_AMV_and_has_not_the_Best_correlation_value
flag_meanings        AMV_which_is_not_the_initially_calculated_AMV_but_has_the_Best_correlation_value
flag_meanings        AMV_which_is_the_initially_calculated_AMV_but_has_not_the_Best_correlation_value
flag_meanings        AMV_which_is_the_initially_calculated_AMV_and_has_the_Best_correlation_value
BLOCK_END

# Attributes for quality_test
# ------------------------------
BLOCK_quality_test
standard_name        
long_name            quality_test
units                1
valid_range          0u, 1024u
_FillValue           2047
ancillary_variables  
coordinates          time lat lon
comment              Quality test; Values based on BUFR code table 060202; It stores a bit mask with values for Orographic|Forecast|Spatial|Temporal|Two scale flags (two bits each one of them)
comment              For each one of the flags: 0 - Corresponding Quality test could not be calculated; 
comment                                         1 - Among the AMVs for the tracer, this AMV has a rather worse result for this Quality test;
comment                                         2 - Among the AMVs for the tracer, this AMV has a slightly worse result for this Quality test;
comment                                         3 - Among the AMVs for the tracer, this AMV has the best result for this Quality test
BLOCK_END

# Attributes for segment_x
# ------------------------------
BLOCK_segment_x
standard_name        
long_name            segment_x (m)
units                m
valid_range          0u, 262140u
_FillValue           262143
ancillary_variables  
coordinates          time lat lon
comment              Tracer longitudinal size in metres
BLOCK_END

