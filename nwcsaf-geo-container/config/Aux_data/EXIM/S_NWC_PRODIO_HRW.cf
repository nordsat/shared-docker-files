BLOCK_END

# Attributes for lat
# -------------------------------------------
BLOCK_lat
standard_name        latitude
long_name            latitude (degrees_north)
units                degrees_north
valid_range          -90.0, 90.0
_FillValue           245.0
ancillary_variables  
coordinates          
comment              Latitude; name reduced to lat due to need by processing apps
BLOCK_END

# Attributes for lon
# -------------------------------------------
BLOCK_lon
standard_name        longitude     
long_name            longitude (degrees_east)
units                degrees_east
valid_range          -180.0, 179.99999
_FillValue           +491.0
ancillary_variables  
coordinates          
comment              Longitude; name reduced to lon due to need by processing apps
BLOCK_END

