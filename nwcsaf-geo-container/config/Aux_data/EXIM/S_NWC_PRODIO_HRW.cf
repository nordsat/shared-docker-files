flag_meanings        CCC_height_assignment._High_threshold._Cold_branch._Clear_air_AMV
flag_meanings        CCC_height_assignment._Low_threshold._Cold_or_Bright_branch._Cloudy_AMV._Undefined_cloud_phase
flag_meanings        CCC_height_assignment._High_threshold._Cold_or_Bright_branch._Cloudy_AMV._Undefined_cloud_phase
flag_meanings        CCC_height_assignment._Low_threshold._Cold_or_Bright_branch._Cloudy_AMV._Liquid_cloud_phase
