flag_meanings        CCC_height_assignment_with_Microphysics_correction._Low_threshold._Cold_or_Bright_branch._Cloudy_AMV._Ice_cloud_phase
flag_meanings        CCC_height_assignment_with_Microphysics_correction._High_threshold._Cold_or_Bright_branch._Cloudy_AMV._Ice_cloud_phase
