# Attributes for Header - AUX
# ------------------------------
TITLE       NWC GEO Auxiliary Product - Lat/Lon
SUMMARY     latitude and Longitude data Product of the NWC/GEO
KEYWORDS    Auxiliary
CDM         Image

# Palette Definition
# ------------------------------


# Attributes for Container latitude
# ------------------------------------
BLOCK_latitude
standard_name        latitude
long_name            Latitude at the centre of each pixel
units                degrees_north
valid_range          -90.0, 90.0
_FillValue           -9999.0
BLOCK_END

# Attributes for Container longitude
# ------------------------------------
BLOCK_longitude
standard_name        longitude
long_name            Longitude at the centre of each pixel
units                degrees_east
valid_range          -180.0, 180.0
_FillValue           -9999.0
BLOCK_END
